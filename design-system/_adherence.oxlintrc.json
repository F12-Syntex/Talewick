        "message": "<HypeIndicator> doesn't accept that prop. Declared props: level, variant, showLabel, size, animated."
      },
      {
        "selector": "JSXOpeningElement[name.name='HypeIndicator'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:bars|meter|pill)$/]",
        "message": "<HypeIndicator> variant must be one of 'bars' | 'meter' | 'pill'."
