{
  "name": "talewick",
  "productName": "Talewick",
  "version": "0.4.1",
  "private": true,
  "description": "Advanced desktop book reader",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build && yarn build:electron",
    "build:electron": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --format=cjs --target=node22 --outdir=dist-electron --external:electron --sourcemap",
    "start": "electron .",
    "dist": "yarn build && electron-builder",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p electron/tsconfig.json",
    "snap": "yarn -s build && node scripts/snapshot.mjs",
    "snap:dev": "yarn -s build:electron && node scripts/snapshot.mjs --dev"
  },
  "dependencies": {
    "lucide-react": "^1.51.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.5",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "wait-on": "^9.5.1"
  },
  "packageManager": "yarn@1.22.22"
}
